# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DB_NAME=apaar
DB_USER=apaar_user
DB_PASSWORD=apaar_secret
DATABASE_URL=postgresql://apaar_user:apaar_secret@localhost:5432/apaar

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────
# MinIO / S3
# ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads

# ──────────────────────────────────────────
# JWT
# ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────
# Backend
# ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ──────────────────────────────────────────
# Analytics
# ──────────────────────────────────────────
ANALYTICS_URL=http://localhost:8000

# ──────────────────────────────────────────
# Email / SMS (stub)
# ──────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=
